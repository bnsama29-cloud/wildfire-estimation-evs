{
  "version": 1,
  "author": "EL Wildfire Project",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": -105, "left": 190, "attrs": { "temperature": "36", "humidity": "24" } },
    { "type": "wokwi-gas-sensor", "id": "smoke", "top": 90, "left": 190, "attrs": { "ppm": "1" } },
    { "type": "wokwi-led", "id": "alert", "top": -80, "left": -110, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 20, "left": -125, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "dht:VCC", "esp:3V3", "red", [] ],
    [ "dht:GND", "esp:GND.2", "black", [] ],
    [ "dht:SDA", "esp:4", "green", [] ],
    [ "smoke:VCC", "esp:5V", "red", [] ],
    [ "smoke:GND", "esp:GND.2", "black", [] ],
    [ "smoke:AOUT", "esp:34", "orange", [] ],
    [ "alert:A", "esp:2", "yellow", [] ],
    [ "alert:C", "r1:1", "black", [] ],
    [ "r1:2", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
